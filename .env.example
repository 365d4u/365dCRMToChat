# Documentation only: the application does not automatically load .env files.
# Inject API/RabbitMQ credentials from the runtime environment. No DB settings.
CRM_BASE_URL=https://crm.365d4u.com
CRM_MEDIA_TOKEN=
CRM_TO_CHAT_API_TOKEN=
CRM_TO_CHAT_AMQP_URL=
CRM_TO_CHAT_AMQP_INSTANCE_ID=
# Migration only: consume old backlog alongside primary; no second DB writer.
CRM_TO_CHAT_EXCHANGE=
CRM_TO_CHAT_ROUTING_KEY=crm.message.snapshot.v1
CRM_TO_CHAT_WRITE_ENABLED=false
# The durable consumer requires an explicit allowed workspace list.
CRM_TO_CHAT_WORKSPACE_IDS=1
